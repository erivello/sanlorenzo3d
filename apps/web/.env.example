# Copy to .env.local (git-ignored).
# Splat produced by the pipeline, served from apps/web/public/splats/:
# VITE_SPLAT_URL=/splats/interno.sog

# Google Maps Platform key, restricted to your referrers, billing enabled.
# Used for Street View (Maps JavaScript API). Photorealistic 3D Tiles only with VITE_TERRAIN=google
# (blocked for EEA billing accounts since 2025-07-08).
# VITE_GOOGLE_MAPS_API_KEY=
# VITE_TERRAIN=google

# Imagery on the open terrain (src/imagery.ts). Esri World Imagery: ArcGIS Location Platform API key
# with the basemap privilege (free tier). AGEA 2024 orthophoto (Regione Veneto WMS) is on in dev;
# set VITE_AGEA_PUBLIC=1 only once permission to publish it exists.
# VITE_ESRI_API_KEY=
# VITE_AGEA_PUBLIC=1
# Default imagery when several are available: esri | agea
# VITE_IMAGERY=agea
